# ── Microsoft 365 / Azure AD ────────────────────────────────────────────────
# Register an app at https://portal.azure.com > Azure AD > App registrations
# Redirect URI: http://localhost  (type: Public client / native)
MS_CLIENT_ID=your-azure-app-client-id
MS_TENANT_ID=common          # or your tenant id / domain

# ── Azure Storage (optional, only for Azure Blob / Table connector) ─────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_ACCOUNT_NAME=mystorageaccount

# ── Paths ────────────────────────────────────────────────────────────────────
DATABASE_DIR=./databases

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
